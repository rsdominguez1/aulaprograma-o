<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ONG Solidária - Plataforma Completa</title>
    
    <!-- CSS Principal -->
    <link rel="stylesheet" href="css/style.css">
    
    <!-- Componentes CSS -->
    <link rel="stylesheet" href="css/components/buttons.css">
    <link rel="stylesheet" href="css/components/cards.css">
    <link rel="stylesheet" href="css/components/forms.css">
    <link rel="stylesheet" href="css/components/navigation.css">
    <link rel="stylesheet" href="css/components/grid.css">
    <link rel="stylesheet" href="css/components/alerts.css">
    
    <!-- Layout CSS -->
    <link rel="stylesheet" href="css/layout/header.css">
    <link rel="stylesheet" href="css/layout/footer.css">
    <link rel="stylesheet" href="css/layout/sections.css">
    
    <!-- Base CSS -->
    <link rel="stylesheet" href="css/base/variables.css">
    <link rel="stylesheet" href="css/base/reset.css">
    <link rel="stylesheet" href="css/base/typography.css">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <!-- Cabeçalho -->
    <header class="header">
        <div class="container header-container">
            <div class="logo">
                <img src="images/logo.png" alt="Logo ONG Solidária">
                <h1>ONG Solidária</h1>
            </div>
            
            <button class="mobile-menu-toggle" aria-label="Abrir menu" aria-expanded="false">
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
            </button>
            
            <nav class="navigation">
                <ul class="nav-list">
                    <li class="nav-item">
                        <a href="#" class="nav-link active" data-page="home">Início</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a href="#" class="nav-link" data-page="projects">Projetos <i class="fas fa-chevron-down"></i></a>
                        <ul class="dropdown-menu">
                            <li><a href="#" class="dropdown-link" data-project="educacao">Educação</a></li>
                            <li><a href="#" class="dropdown-link" data-project="saude">Saúde</a></li>
                            <li><a href="#" class="dropdown-link" data-project="sustentabilidade">Sustentabilidade</a></li>
                            <li><a href="#" class="dropdown-link" data-project="emergencia">Ações de Emergência</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link" data-page="volunteers">Voluntários</a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link" data-page="donations">Doações</a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link" data-page="registration">Cadastro</a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link" data-page="contact">Contato</a>
                    </li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- Conteúdo Principal -->
    <main class="main-content">
        <!-- Página Inicial -->
        <section id="home" class="page active">
            <!-- Hero Section -->
            <section class="hero">
                <div class="container">
                    <div class="hero-content">
                        <h2 class="hero-title">Transformando Vidas, Construindo Futuros</h2>
                        <p class="hero-description">Há mais de 15 anos atuando em comunidades carentes, promovendo educação, saúde e oportunidades para milhares de pessoas.</p>
                        <div class="hero-actions">
                            <button class="btn btn-primary btn-large" data-page="registration">
                                <i class="fas fa-hands-helping"></i>
                                Seja um Voluntário
                            </button>
                            <button class="btn btn-secondary btn-large" data-page="projects">
                                <i class="fas fa-project-diagram"></i>
                                Conheça nossos Projetos
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Sobre Nós -->
            <section class="about section-padding">
                <div class="container">
                    <h2 class="section-title">Sobre Nós</h2>
                    <div class="grid grid-cols-1 grid-cols-md-2 gap-lg">
                        <div class="about-content">
                            <div class="about-text">
                                <h3 class="about-subtitle">Nossa Missão</h3>
                                <p class="about-description">Promover o desenvolvimento social e humano através de ações que garantam direitos, ampliem oportunidades e fortaleçam a cidadania em comunidades vulneráveis.</p>
                                
                                <h3 class="about-subtitle">Nossa Visão</h3>
                                <p class="about-description">Ser referência nacional em transformação social, com projetos sustentáveis que gerem impacto positivo e duradouro na vida das pessoas.</p>
                                
                                <h3 class="about-subtitle">Nossos Valores</h3>
                                <div class="values-grid grid grid-cols-1 grid-cols-sm-3 gap-md">
                                    <div class="value-card card">
                                        <div class="value-icon">
                                            <i class="fas fa-heart"></i>
                                        </div>
                                        <h4 class="value-title">Solidariedade</h4>
                                        <p class="value-description">Agimos com empatia e compromisso com o próximo.</p>
                                    </div>
                                    <div class="value-card card">
                                        <div class="value-icon">
                                            <i class="fas fa-handshake"></i>
                                        </div>
                                        <h4 class="value-title">Transparência</h4>
                                        <p class="value-description">Prestamos contas de todas as nossas ações e recursos.</p>
                                    </div>
                                    <div class="value-card card">
                                        <div class="value-icon">
                                            <i class="fas fa-users"></i>
                                        </div>
                                        <h4 class="value-title">Colaboração</h4>
                                        <p class="value-description">Acreditamos no poder transformador do trabalho em equipe.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="about-image">
                            <img src="images/teamwork.jpg" alt="Equipe da ONG Solidária" class="responsive-image">
                        </div>
                    </div>
                </div>
            </section>

            <!-- Estatísticas -->
            <section class="stats section-padding bg-light">
                <div class="container">
                    <div class="grid grid-cols-2 grid-cols-sm-4 gap-lg">
                        <div class="stat-card card text-center">
                            <div class="stat-number" data-count="15000">0</div>
                            <div class="stat-label">Pessoas Impactadas</div>
                        </div>
                        <div class="stat-card card text-center">
                            <div class="stat-number" data-count="820">0</div>
                            <div class="stat-label">Voluntários Ativos</div>
                        </div>
                        <div class="stat-card card text-center">
                            <div class="stat-number" data-count="45">0</div>
                            <div class="stat-label">Projetos Realizados</div>
                        </div>
                        <div class="stat-card card text-center">
                            <div class="stat-number" data-count="15">0</div>
                            <div class="stat-label">Anos de Atuação</div>
                        </div>
                    </div>
                </div>
            </section>
        </section>

        <!-- Página Projetos -->
        <section id="projects" class="page">
            <div class="container section-padding">
                <h2 class="section-title">Nossos Projetos</h2>
                
                <!-- Filtros -->
                <div class="filters">
                    <div class="filter-group">
                        <button class="filter-btn active" data-filter="all">Todos</button>
                        <button class="filter-btn" data-filter="educacao">Educação</button>
                        <button class="filter-btn" data-filter="saude">Saúde</button>
                        <button class="filter-btn" data-filter="sustentabilidade">Sustentabilidade</button>
                        <button class="filter-btn" data-filter="emergencia">Emergência</button>
                    </div>
                </div>
                
                <!-- Grid de Projetos -->
                <div class="projects-grid grid grid-cols-1 grid-cols-md-2 grid-cols-lg-3 gap-lg">
                    <!-- Projeto 1 -->
                    <div class="project-card card" data-category="educacao">
                        <div class="project-image">
                            <img src="images/project-education.jpg" alt="Projeto Educação para Todos" class="responsive-image">
                            <div class="project-badges">
                                <span class="badge badge-primary">Educação</span>
                                <span class="badge badge-success">Ativo</span>
                            </div>
                        </div>
                        <div class="project-content">
                            <h3 class="project-title">Educação para Todos</h3>
                            <p class="project-description">Oferecemos reforço escolar, cursos profissionalizantes e biblioteca comunitária para crianças e jovens.</p>
                            <div class="project-meta">
                                <div class="project-stat">
                                    <i class="fas fa-users"></i>
                                    <span>150 crianças atendidas</span>
                                </div>
                                <div class="project-stat">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <span>São Paulo, SP</span>
                                </div>
                            </div>
                            <div class="project-progress">
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: 75%"></div>
                                </div>
                                <div class="progress-text">75% da meta alcançada</div>
                            </div>
                            <div class="project-actions">
                                <button class="btn btn-primary btn-block" data-project="educacao">
                                    <i class="fas fa-hand-holding-heart"></i>
                                    Apoiar este Projeto
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Projeto 2 -->
                    <div class="project-card card" data-category="saude">
                        <div class="project-image">
                            <img src="images/project-health.jpg" alt="Projeto Saúde em Ação" class="responsive-image">
                            <div class="project-badges">
                                <span class="badge badge-secondary">Saúde</span>
                                <span class="badge badge-success">Ativo</span>
                            </div>
                        </div>
                        <div class="project-content">
                            <h3 class="project-title">Saúde em Ação</h3>
                            <p class="project-description">Realizamos mutirões de saúde, prevenção de doenças e acompanhamento de gestantes na comunidade.</p>
                            <div class="project-meta">
                                <div class="project-stat">
                                    <i class="fas fa-users"></i>
                                    <span>2.000 atendimentos</span>
                                </div>
                                <div class="project-stat">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <span>Rio de Janeiro, RJ</span>
                                </div>
                            </div>
                            <div class="project-progress">
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: 60%"></div>
                                </div>
                                <div class="progress-text">60% da meta alcançada</div>
                            </div>
                            <div class="project-actions">
                                <button class="btn btn-primary btn-block" data-project="saude">
                                    <i class="fas fa-hand-holding-heart"></i>
                                    Apoiar este Projeto
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Projeto 3 -->
                    <div class="project-card card" data-category="sustentabilidade">
                        <div class="project-image">
                            <img src="images/project-sustainability.jpg" alt="Projeto Sustentabilidade Comunitária" class="responsive-image">
                            <div class="project-badges">
                                <span class="badge badge-info">Sustentabilidade</span>
                                <span class="badge badge-warning">Em planejamento</span>
                            </div>
                        </div>
                        <div class="project-content">
                            <h3 class="project-title">Sustentabilidade Comunitária</h3>
                            <p class="project-description">Promovemos hortas comunitárias, reciclagem e geração de renda através de práticas sustentáveis.</p>
                            <div class="project-meta">
                                <div class="project-stat">
                                    <i class="fas fa-users"></i>
                                    <span>Famílias beneficiadas</span>
                                </div>
                                <div class="project-stat">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <span>Belo Horizonte, MG</span>
                                </div>
                            </div>
                            <div class="project-progress">
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: 25%"></div>
                                </div>
                                <div class="progress-text">25% da meta alcançada</div>
                            </div>
                            <div class="project-actions">
                                <button class="btn btn-primary btn-block" data-project="sustentabilidade">
                                    <i class="fas fa-hand-holding-heart"></i>
                                    Apoiar este Projeto
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Página Cadastro -->
        <section id="registration" class="page">
            <div class="container section-padding">
                <h2 class="section-title">Cadastro de Voluntário</h2>
                
                <!-- Alertas -->
                <div class="alert alert-success" id="registration-success" style="display: none;">
                    <i class="fas fa-check-circle"></i>
                    <div class="alert-content">
                        <h4 class="alert-title">Cadastro realizado com sucesso!</h4>
                        <p class="alert-description">Em breve entraremos em contato com mais informações.</p>
                    </div>
                    <button class="alert-close" aria-label="Fechar">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                
                <div class="alert alert-error" id="registration-error" style="display: none;">
                    <i class="fas fa-exclamation-circle"></i>
                    <div class="alert-content">
                        <h4 class="alert-title">Erro no cadastro</h4>
                        <p class="alert-description">Por favor, verifique os campos destacados e tente novamente.</p>
                    </div>
                    <button class="alert-close" aria-label="Fechar">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                
                <!-- Formulário -->
                <div class="form-container card">
                    <form id="volunteer-form" class="form">
                        <div class="form-section">
                            <h3 class="form-section-title">Dados Pessoais</h3>
                            <div class="grid grid-cols-1 grid-cols-md-2 gap-md">
                                <div class="form-group">
                                    <label for="full-name" class="form-label">Nome Completo *</label>
                                    <input type="text" id="full-name" class="form-input" required>
                                    <div class="form-error" id="full-name-error"></div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="email" class="form-label">E-mail *</label>
                                    <input type="email" id="email" class="form-input" required>
                                    <div class="form-error" id="email-error"></div>
                                </div>
                            </div>
                            
                            <div class="grid grid-cols-1 grid-cols-md-3 gap-md">
                                <div class="form-group">
                                    <label for="cpf" class="form-label">CPF *</label>
                                    <input type="text" id="cpf" class="form-input" maxlength="14" required>
                                    <div class="form-error" id="cpf-error"></div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="phone" class="form-label">Telefone *</label>
                                    <input type="text" id="phone" class="form-input" maxlength="15" required>
                                    <div class="form-error" id="phone-error"></div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="birthdate" class="form-label">Data de Nascimento *</label>
                                    <input type="date" id="birthdate" class="form-input" required>
                                    <div class="form-error" id="birthdate-error"></div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-section">
                            <h3 class="form-section-title">Endereço</h3>
                            <div class="grid grid-cols-1 grid-cols-md-2 gap-md">
                                <div class="form-group">
                                    <label for="cep" class="form-label">CEP *</label>
                                    <input type="text" id="cep" class="form-input" maxlength="9" required>
                                    <div class="form-error" id="cep-error"></div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="address" class="form-label">Endereço *</label>
                                    <input type="text" id="address" class="form-input" required>
                                    <div class="form-error" id="address-error"></div>
                                </div>
                            </div>
                            
                            <div class="grid grid-cols-1 grid-cols-md-2 gap-md">
                                <div class="form-group">
                                    <label for="city" class="form-label">Cidade *</label>
                                    <input type="text" id="city" class="form-input" required>
                                    <div class="form-error" id="city-error"></div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="state" class="form-label">Estado *</label>
                                    <select id="state" class="form-select" required>
                                        <option value="">Selecione...</option>
                                        <option value="AC">Acre</option>
                                        <option value="AL">Alagoas</option>
                                        <option value="AP">Amapá</option>
                                        <option value="AM">Amazonas</option>
                                        <option value="BA">Bahia</option>
                                        <option value="CE">Ceará</option>
                                        <option value="DF">Distrito Federal</option>
                                        <option value="ES">Espírito Santo</option>
                                        <option value="GO">Goiás</option>
                                        <option value="MA">Maranhão</option>
                                        <option value="MT">Mato Grosso</option>
                                        <option value="MS">Mato Grosso do Sul</option>
                                        <option value="MG">Minas Gerais</option>
                                        <option value="PA">Pará</option>
                                        <option value="PB">Paraíba</option>
                                        <option value="PR">Paraná</option>
                                        <option value="PE">Pernambuco</option>
                                        <option value="PI">Piauí</option>
                                        <option value="RJ">Rio de Janeiro</option>
                                        <option value="RN">Rio Grande do Norte</option>
                                        <option value="RS">Rio Grande do Sul</option>
                                        <option value="RO">Rondônia</option>
                                        <option value="RR">Roraima</option>
                                        <option value="SC">Santa Catarina</option>
                                        <option value="SP">São Paulo</option>
                                        <option value="SE">Sergipe</option>
                                        <option value="TO">Tocantins</option>
                                    </select>
                                    <div class="form-error" id="state-error"></div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-section">
                            <h3 class="form-section-title">Habilidades e Interesses</h3>
                            <div class="form-group">
                                <label for="skills" class="form-label">Habilidades e Interesses</label>
                                <textarea id="skills" class="form-textarea" placeholder="Descreva suas habilidades, formações e áreas de interesse..."></textarea>
                            </div>
                            
                            <div class="form-group">
                                <label for="availability" class="form-label">Disponibilidade</label>
                                <select id="availability" class="form-select">
                                    <option value="">Selecione...</option>
                                    <option value="weekends">Finais de semana</option>
                                    <option value="weekdays">Dias de semana</option>
                                    <option value="flexible">Horários flexíveis</option>
                                    <option value="specific">Horários específicos</option>
                                </select>
                            </div>
                            
                            <div class="form-group">
                                <label class="form-label">Áreas de Interesse</label>
                                <div class="checkbox-group">
                                    <label class="checkbox">
                                        <input type="checkbox" name="interests" value="educacao">
                                        <span class="checkmark"></span>
                                        Educação
                                    </label>
                                    <label class="checkbox">
                                        <input type="checkbox" name="interests" value="saude">
                                        <span class="checkmark"></span>
                                        Saúde
                                    </label>
                                    <label class="checkbox">
                                        <input type="checkbox" name="interests" value="sustentabilidade">
                                        <span class="checkmark"></span>
                                        Sustentabilidade
                                    </label>
                                    <label class="checkbox">
                                        <input type="checkbox" name="interests" value="emergencia">
                                        <span class="checkmark"></span>
                                        Ações de Emergência
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-actions">
                            <button type="reset" class="btn btn-secondary">
                                <i class="fas fa-undo"></i>
                                Limpar
                            </button>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane"></i>
                                Enviar Cadastro
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </section>

        <!-- Modal de Confirmação -->
        <div class="modal" id="confirmation-modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="modal-title">Confirmação de Cadastro</h3>
                    <button class="modal-close" aria-label="Fechar">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Seu cadastro foi realizado com sucesso! Em breve nossa equipe entrará em contato para dar continuidade ao processo.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" id="modal-confirm">Entendido</button>
                </div>
            </div>
        </div>
    </main>

    <!-- Rodapé -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content grid grid-cols-1 grid-cols-md-2 grid-cols-lg-4 gap-lg">
                <div class="footer-column">
                    <h3 class="footer-title">ONG Solidária</h3>
                    <p class="footer-description">Transformando vidas através de ações sociais, voluntariado e doações. Junte-se a nós nessa causa!</p>
                    <div class="social-links">
                        <a href="#" class="social-link" aria-label="Facebook">
                            <i class="fab fa-facebook-f"></i>
