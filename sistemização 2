                        <li><a href="#" class="footer-link" data-page="contact">Contato</a></li>
                    </ul>
                </div>
                
                <div class="footer-column">
                    <h3 class="footer-title">Nossos Projetos</h3>
                    <ul class="footer-links">
                        <li><a href="#" class="footer-link" data-page="projects">Educação para Todos</a></li>
                        <li><a href="#" class="footer-link" data-page="projects">Saúde em Ação</a></li>
                        <li><a href="#" class="footer-link" data-page="projects">Sustentabilidade</a></li>
                        <li><a href="#" class="footer-link" data-page="projects">Geração de Renda</a></li>
                    </ul>
                </div>
                
                <div class="footer-column">
                    <h3 class="footer-title">Transparência</h3>
                    <ul class="footer-links">
