                </div>
            </div>
            
            <div class="footer-bottom">
                <p class="copyright">&copy; 2023 ONG Solidária. Todos os direitos reservados. CNPJ: 12.345.678/0001-90</p>
            </div>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="js/main.js"></script>
    <script src="js/navigation.js"></script>
    <script src="js/forms.js"></script>
