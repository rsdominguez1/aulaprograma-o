            // Navegação entre páginas
            navigateToPage(page) {
                // Esconder todas as páginas
                document.querySelectorAll('.page').forEach(p => {
                    p.classList.remove('active');
                });
                
                // Mostrar a página selecionada
                document.getElementById(page).classList.add('active');
                
                // Atualizar navegação ativa
                this.updateActiveNavigation(page);
                
                // Atualizar estado atual
                this.currentPage = page;
                
                // Executar ações específicas da página
                this.executePageActions(page);
                
                // Fechar menu mobile se estiver aberto
                this.closeMobileMenu();
            }

            updateActiveNavigation(page) {
                // Remover classe active de todos os links
                document.querySelectorAll('.nav-link').forEach(link => {
                    link.classList.remove('active');
                });
                
                // Adicionar classe active ao link atual
                const currentLink = document.querySelector(`[data-page="${page}"]`);
                if (currentLink) {
                    currentLink.classList.add('active');
                }
            }

            executePageActions(page) {
                switch (page) {
                    case 'home':
                        this.animateStatistics();
                        break;
                    case 'projects':
                        this.renderProjects();
                        break;
                    case 'volunteers':
                        this.renderVolunteers();
                        break;
                }
            }

            // Menu Mobile
            toggleMobileMenu() {
                const navigation = document.querySelector('.navigation');
                const toggle = document.querySelector('.mobile-menu-toggle');
                
                navigation.classList.toggle('active');
                const isExpanded = navigation.classList.contains('active');
                toggle.setAttribute('aria-expanded', isExpanded);
            }

            closeMobileMenu() {
                document.querySelector('.navigation').classList.remove('active');
                document.querySelector('.mobile-menu-toggle').setAttribute('aria-expanded', 'false');
            }

            // Sistema de Filtros
            initializeProjectFilters() {
                // Inicializar filtros ativos
                document.querySelectorAll('.filter-btn.active').forEach(btn => {
                    this.filters.add(btn.getAttribute('data-filter'));
                });
            }

            handleFilterClick(button) {
                const filter = button.getAttribute('data-filter');
                
                // Se for "all", limpar outros filtros
                if (filter === 'all') {
                    this.clearFilters();
                } else {
                    // Remover "all" dos filtros ativos
                    this.filters.delete('all');
                    document.querySelector('[data-filter="all"]').classList.remove('active');
                    
                    // Toggle do filtro selecionado
                    if (this.filters.has(filter)) {
                        this.filters.delete(filter);
                        button.classList.remove('active');
                    } else {
                        this.filters.add(filter);
                        button.classList.add('active');
                    }
                }
                
                // Se nenhum filtro está ativo, ativar "all"
                if (this.filters.size === 0) {
                    this.filters.add('all');
                    document.querySelector('[data-filter="all"]').classList.add('active');
                }
                
                this.applyFilters();
            }

            clearFilters() {
                this.filters.clear();
                this.filters.add('all');
                
                document.querySelectorAll('.filter-btn').forEach(btn => {
                    btn.classList.remove('active');
                });
                
                document.querySelector('[data-filter="all"]').classList.add('active');
            }

            applyFilters() {
                const projects = document.querySelectorAll('.project-card');
                
                projects.forEach(project => {
                    const category = project.getAttribute('data-category');
                    const shouldShow = this.shouldShowProject(category);
                    
                    if (shouldShow) {
                        project.style.display = 'block';
                        setTimeout(() => {
                            project.style.opacity = '1';
                            project.style.transform = 'translateY(0)';
                        }, 50);
                    } else {
                        project.style.opacity = '0';
                        project.style.transform = 'translateY(20px)';
                        setTimeout(() => {
                            project.style.display = 'none';
                        }, 300);
                    }
                });

                this.showNoResultsMessage();
            }

            shouldShowProject(category) {
                if (this.filters.has('all')) return true;
                return this.filters.has(category);
            }

            showNoResultsMessage() {
                const container = document.getElementById('projects-grid');
                const visibleProjects = container.querySelectorAll('.project-card[style*="display: block"]');
                
                let message = container.querySelector('.no-results-message');
                
                if (visibleProjects.length === 0) {
                    if (!message) {
                        message = document.createElement('div');
                        message.className = 'no-results-message text-center';
                        message.innerHTML = `
                            <i class="fas fa-search fa-3x" style="color: var(--color-gray-400); margin-bottom: var(--space-md);"></i>
                            <h3>Nenhum projeto encontrado</h3>
                            <p>Tente ajustar os filtros para ver mais resultados.</p>
                            <button class="btn btn-primary clear-filters-btn" style="margin-top: var(--space-md);">
                                Limpar Filtros
                            </button>
                        `;
                        container.appendChild(message);
                        
                        message.querySelector('.clear-filters-btn').addEventListener('click', () => {
                            this.clearFilters();
                        });
                    }
                } else if (message) {
                    message.remove();
                }
            }

            // Renderização de Projetos
            renderProjects() {
                const container = document.getElementById('projects-grid');
                if (!container) return;
                
                container.innerHTML = '';
                
                this.projects.forEach(project => {
                    const projectElement = this.createProjectElement(project);
                    container.appendChild(projectElement);
                });
            }

            createProjectElement(project) {
                const element = document.createElement('div');
                element.className = 'project-card card';
                element.setAttribute('data-category', project.category);
                
                const categoryName = this.getCategoryName(project.category);
                const categoryColor = this.getCategoryColor(project.category);
                const statusText = project.status === 'active' ? 'Ativo' : 'Em planejamento';
                const statusColor = project.status === 'active' ? 'success' : 'warning';
                
                element.innerHTML = `
                    <div class="project-image">
                        <img src="${project.image}" alt="${project.title}" class="responsive-image">
                        <div class="project-badges">
                            <span class="badge badge-${categoryColor}">${categoryName}</span>
                            <span class="badge badge-${statusColor}">${statusText}</span>
                        </div>
                    </div>
                    <div class="project-content">
                        <h3 class="project-title">${project.title}</h3>
                        <p class="project-description">${project.description}</p>
                        <div class="project-meta">
                            <div class="project-stat">
                                <i class="fas fa-users"></i>
                                <span>${project.impact}</span>
                            </div>
                            <div class="project-stat">
                                <i class="fas fa-map-marker-alt"></i>
                                <span>${project.location}</span>
                            </div>
                        </div>
                        <div class="project-progress">
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: ${project.progress}%"></div>
                            </div>
                            <div class="progress-text">${project.progress}% da meta alcançada</div>
                        </div>
                        <div class="project-actions">
                            <button class="btn btn-primary btn-block btn-volunteer" data-project="${project.id}">
                                <i class="fas fa-hand-holding-heart"></i>
                                Apoiar este Projeto
                            </button>
                        </div>
                    </div>
                `;
                
                // Adicionar evento ao botão de voluntariado
                element.querySelector('.btn-volunteer').addEventListener('click', () => {
                    this.handleVolunteerInterest(project.id);
                });
                
                return element;
            }

            getCategoryName(category) {
                const names = {
                    'educacao': 'Educação',
                    'saude': 'Saúde',
                    'sustentabilidade': 'Sustentabilidade',
                    'emergencia': 'Emergência'
                };
                return names[category] || 'Geral';
            }

            getCategoryColor(category) {
                const colors = {
                    'educacao': 'primary',
                    'saude': 'secondary',
                    'sustentabilidade': 'info',
                    'emergencia': 'error'
                };
                return colors[category] || 'primary';
            }

            // Voluntários
            renderVolunteers() {
                const container = document.getElementById('volunteers-list');
                if (!container) return;
                
                container.innerHTML = '';
                
                this.volunteers.forEach(volunteer => {
                    const row = this.createVolunteerRow(volunteer);
                    container.appendChild(row);
                });
            }

            createVolunteerRow(volunteer) {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${volunteer.name}</td>
                    <td>${volunteer.email}</td>
                    <td>${volunteer.phone}</td>
                    <td>${volunteer.skills}</td>
                    <td>${volunteer.project}</td>
                    <td>
                        <button class="btn btn-small btn-outline contact-volunteer" data-id="${volunteer.id}">Contatar</button>
                    </td>
                `;
                
                row.querySelector('.contact-volunteer').addEventListener('click', () => {
                    this.contactVolunteer(volunteer.id);
                });
                
                return row;
            }

            searchVolunteers() {
                const searchTerm = document.getElementById('search-volunteer').value.toLowerCase();
                const volunteers = document.querySelectorAll('#volunteers-list tr');
                
                volunteers.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    if (text.includes(searchTerm)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            contactVolunteer(id) {
                const volunteer = this.volunteers.find(v => v.id === id);
                if (volunteer) {
                    this.showAlert(`Contato com ${volunteer.name} seria iniciado. Em uma aplicação real, isso enviaria um e-mail ou abriria um chat.`, 'info');
                }
            }

            // Formulários
            handleVolunteerRegistration(form) {
                if (this.validateForm(form)) {
                    const formData = new FormData(form);
                    const volunteer = {
                        id: Date.now(),
                        name: formData.get('full-name'),
                        email: formData.get('email'),
                        phone: formData.get('phone'),
                        skills: formData.get('skills'),
                        project: 'Aguardando alocação',
                        status: 'pending',
                        registrationDate: new Date().toISOString()
                    };
                    
                    this.volunteers.push(volunteer);
                    this.saveToStorage('volunteers', this.volunteers);
                    
                    this.showModal('confirmation-modal');
                    form.reset();
                    
                    this.showAlert('Cadastro realizado com sucesso! Em breve entraremos em contato.', 'success');
                } else {
                    this.showAlert('Por favor, corrija os erros no formulário antes de enviar.', 'error');
                }
            }

            handleContactForm(form) {
                if (this.validateForm(form)) {
                    this.showAlert('Mensagem enviada com sucesso! Responderemos em breve.', 'success');
                    form.reset();
                } else {
                    this.showAlert('Por favor, preencha todos os campos obrigatórios.', 'error');
                }
            }

            validateForm(form) {
                let isValid = true;
                const requiredFields = form.querySelectorAll('[required]');
                
                requiredFields.forEach(field => {
                    if (!field.value.trim()) {
                        this.showFieldError(field, 'Este campo é obrigatório');
                        isValid = false;
                    } else {
                        this.clearFieldError(field);
                        
                        // Validações específicas por tipo de campo
                        if (field.type === 'email' && !this.isValidEmail(field.value)) {
                            this.showFieldError(field, 'Digite um e-mail válido');
                            isValid = false;
                        }
                        
                        if (field.id === 'cpf' && !this.isValidCPF(field.value)) {
                            this.showFieldError(field, 'CPF inválido');
                            isValid = false;
                        }
                    }
                });
                
                return isValid;
            }

            isValidEmail(email) {
                const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                return re.test(email);
            }

            isValidCPF(cpf) {
                cpf = cpf.replace(/\D/g, '');
                return cpf.length === 11;
            }

            showFieldError(field, message) {
                this.clearFieldError(field);
                
                field.classList.add('invalid');
                field.classList.remove('valid');
                
                const errorElement = document.createElement('div');
                errorElement.className = 'form-error';
                errorElement.textContent = message;
                errorElement.id = `${field.name}-error`;
                
                field.parentNode.appendChild(errorElement);
            }

            clearFieldError(field) {
                field.classList.remove('invalid', 'valid');
                
                const errorElement = field.parentNode.querySelector('.form-error');
                if (errorElement) {
                    errorElement.remove();
                }
            }

            // Doações
            handleDonation() {
                const donorName = document.getElementById('donor-name').value;
                const donorEmail = document.getElementById('donor-email').value;
                
                if (!donorName || !donorEmail) {
                    this.showAlert('Por favor, preencha seu nome e e-mail.', 'error');
                    return;
                }
                
                const donationType = document.querySelector('input[name="donation-type"]:checked').value;
                let donationData = {
                    id: Date.now(),
                    donorName,
                    donorEmail,
                    type: donationType,
                    date: new Date().toISOString()
                };
                
                if (donationType === 'money') {
                    const amount = document.getElementById('donation-amount').value;
                    const paymentMethod = document.getElementById('payment-method').value;
                    donationData.amount = parseFloat(amount);
                    donationData.paymentMethod = paymentMethod;
                } else {
                    const items = document.getElementById('donation-items-list').value;
                    const address = document.getElementById('pickup-address').value;
                    donationData.items = items;
                    donationData.pickupAddress = address;
                }
                
                this.donations.push(donationData);
                this.saveToStorage('donations', this.donations);
                
                this.showAlert('Doação registrada com sucesso! Obrigado pela sua contribuição.', 'success');
                
                // Limpar formulário
                document.getElementById('donor-name').value = '';
                document.getElementById('donor-email').value = '';
                document.getElementById('donation-amount').value = '50';
                document.getElementById('donation-items-list').value = '';
                document.getElementById('pickup-address').value = '';
            }

            toggleDonationType(type) {
                const moneySection = document.getElementById('money-donation');
                const itemsSection = document.getElementById('items-donation');
                
                if (type === 'money') {
                    moneySection.style.display = 'block';
                    itemsSection.style.display = 'none';
                } else {
                    moneySection.style.display = 'none';
                    itemsSection.style.display = 'block';
                }
            }

            // Interesse em Projetos
            handleVolunteerInterest(projectId) {
                const project = this.projects.find(p => p.id === projectId);
                if (project) {
                    this.showAlert(`Seu interesse no projeto "${project.title}" foi registrado! Em breve entraremos em contato.`, 'info');
                    
                    // Redirecionar para cadastro se não estiver na página de cadastro
                    if (this.currentPage !== 'registration') {
                        this.navigateToPage('registration');
                    }
                }
            }

            // Animações
            animateStatistics() {
                const counters = document.querySelectorAll('.stat-number');
                counters.forEach(counter => {
                    const target = parseInt(counter.getAttribute('data-count'));
                    this.animateCounter(counter, target, 2000);
                });
            }

            animateCounter(element, target, duration) {
                let start = 0;
                const increment = target / (duration / 16);
                
                const timer = setInterval(() => {
                    start += increment;
                    if (start >= target) {
                        element.textContent = target.toLocaleString();
                        clearInterval(timer);
                    } else {
                        element.textContent = Math.floor(start).toLocaleString();
                    }
                }, 16);
            }

            // Sistema de Alertas
            showAlert(message, type = 'info') {
                const alertContainer = document.getElementById('alert-container');
                
                const alert = document.createElement('div');
                alert.className = `alert alert-${type}`;
                alert.innerHTML = `
                    <div class="alert-icon">
                        <i class="fas fa-${this.getAlertIcon(type)}"></i>
                    </div>
                    <div class="alert-content">
                        <h4 class="alert-title">${this.getAlertTitle(type)}</h4>
                        <p class="alert-description">${message}</p>
                    </div>
                    <button class="alert-close" aria-label="Fechar">
                        <i class="fas fa-times"></i>
                    </button>
                `;
                
                alertContainer.appendChild(alert);
                
                // Auto-remover após 5 segundos
                setTimeout(() => {
                    alert.remove();
                }, 5000);
                
                // Fechar manualmente
                alert.querySelector('.alert-close').addEventListener('click', () => {
                    alert.remove();
                });
            }

            getAlertIcon(type) {
                const icons = {
                    success: 'check-circle',
                    error: 'exclamation-circle',
                    warning: 'exclamation-triangle',
                    info: 'info-circle'
                };
                return icons[type] || 'info-circle';
            }

            getAlertTitle(type) {
                const titles = {
                    success: 'Sucesso',
                    error: 'Erro',
                    warning: 'Aviso',
                    info: 'Informação'
                };
                return titles[type] || 'Informação';
            }

            // Modal
            showModal(modalId) {
                const modal = document.getElementById(modalId);
                if (modal) {
                    modal.classList.add('active');
                    document.body.style.overflow = 'hidden';
                }
            }

            hideModal(modalId) {
                const modal = document.getElementById(modalId);
                if (modal) {
                    modal.classList.remove('active');
                    document.body.style.overflow = '';
                }
            }

            // Máscaras de Input
            applyInputMasks() {
                // CPF
                const cpfInput = document.getElementById('cpf');
                if (cpfInput) {
                    cpfInput.addEventListener('input', (e) => {
                        let value = e.target.value.replace(/\D/g, '');
                        if (value.length <= 11) {
                            value = value.replace(/(\d{3})(\d)/, '$1.$2');
                            value = value.replace(/(\d{3})(\d)/, '$1.$2');
                            value = value.replace(/(\d{3})(\d{1,2})$/, '$1-$2');
                        }
                        e.target.value = value;
                    });
                }
                
                // Telefone
                const phoneInput = document.getElementById('phone');
                if (phoneInput) {
                    phoneInput.addEventListener('input', (e) => {
                        let value = e.target.value.replace(/\D/g, '');
                        if (value.length <= 11) {
                            if (value.length <= 10) {
                                value = value.replace(/(\d{2})(\d)/, '($1) $2');
                                value = value.replace(/(\d{4})(\d)/, '$1-$2');
                            } else {
                                value = value.replace(/(\d{2})(\d)/, '($1) $2');
                                value = value.replace(/(\d{5})(\d)/, '$1-$2');
                            }
                        }
                        e.target.value = value;
                    });
                }
                
                // CEP
                const cepInput = document.getElementById('cep');
                if (cepInput) {
                    cepInput.addEventListener('input', (e) => {
                        let value = e.target.value.replace(/\D/g, '');
                        if (value.length <= 8) {
                            value = value.replace(/(\d{5})(\d)/, '$1-$2');
                        }
                        e.target.value = value;
                    });
                }
            }

            // Armazenamento Local
            saveToStorage(key, value) {
                try {
                    const serializedValue = JSON.stringify(value);
                    this.storage.setItem(key, serializedValue);
                    return true;
                } catch (error) {
                    console.error('Erro ao salvar no storage:', error);
                    return false;
                }
            }

            getFromStorage(key) {
                try {
                    const item = this.storage.getItem(key);
                    return item ? JSON.parse(item) : null;
                } catch (error) {
                    console.error('Erro ao recuperar do storage:', error);
                    return null;
                }
            }
        }

        // Inicializar aplicação quando o DOM estiver carregado
        document.addEventListener('DOMContentLoaded', () => {
            window.ONGApp = new ONGApp();
        });
    </script>
</body>
</html>
