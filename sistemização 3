        // Aplicação Principal - Single Page Application
        class ONGApp {
            constructor() {
                this.currentPage = 'home';
                this.volunteers = [];
                this.projects = [];
                this.donations = [];
                this.filters = new Set(['all']);
                
                this.init();
            }

            init() {
                this.initializeStorage();
                this.initializeEventListeners();
                this.initializeComponents();
                this.loadInitialData();
                
                console.log('ONG App inicializada com sucesso!');
            }

            initializeStorage() {
                // Verificar se o localStorage está disponível
                if (typeof(Storage) !== "undefined") {
                    this.storage = window.localStorage;
                    this.initializeDataStructures();
                } else {
                    console.error("LocalStorage não suportado!");
                }
            }

            initializeDataStructures() {
                const structures = {
                    'volunteers': [],
                    'projects': [],
                    'donations': [],
                    'users': [],
                    'settings': {}
                };

                Object.keys(structures).forEach(key => {
                    if (!this.getFromStorage(key)) {
                        this.saveToStorage(key, structures[key]);
                    }
                });
            }

            initializeEventListeners() {
                // Navegação
                document.addEventListener('click', (e) => {
                    const link = e.target.closest('[data-page]');
                    if (link) {
                        e.preventDefault();
                        const page = link.getAttribute('data-page');
                        this.navigateToPage(page);
                    }
                });

                // Menu mobile
                document.querySelector('.mobile-menu-toggle').addEventListener('click', () => {
                    this.toggleMobileMenu();
                });

                // Filtros de projetos
                document.addEventListener('click', (e) => {
                    if (e.target.matches('.filter-btn')) {
                        this.handleFilterClick(e.target);
                    }
                });

                // Formulário de cadastro
                document.getElementById('volunteer-form').addEventListener('submit', (e) => {
                    e.preventDefault();
                    this.handleVolunteerRegistration(e.target);
                });

                // Formulário de contato
                document.getElementById('contact-form').addEventListener('submit', (e) => {
                    e.preventDefault();
                    this.handleContactForm(e.target);
                });

                // Doações
                document.getElementById('donate-btn').addEventListener('click', () => {
                    this.handleDonation();
                });

                // Tipo de doação
                document.querySelectorAll('input[name="donation-type"]').forEach(radio => {
                    radio.addEventListener('change', (e) => {
                        this.toggleDonationType(e.target.value);
                    });
                });

                // Busca de voluntários
                document.getElementById('search-btn').addEventListener('click', () => {
                    this.searchVolunteers();
                });

                // Modal de confirmação
                document.getElementById('modal-confirm').addEventListener('click', () => {
                    this.hideModal('confirmation-modal');
                });

                // Fechar modal ao clicar no backdrop
                document.getElementById('confirmation-modal').addEventListener('click', (e) => {
                    if (e.target === e.currentTarget) {
                        this.hideModal('confirmation-modal');
                    }
                });

                // Fechar modal com ESC
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') {
                        this.hideModal('confirmation-modal');
                    }
                });

                // Aplicar máscaras aos inputs
                this.applyInputMasks();
            }

            initializeComponents() {
                // Inicializar componentes específicos
                this.initializeProjectFilters();
            }

            loadInitialData() {
                // Carregar dados do localStorage
                this.volunteers = this.getFromStorage('volunteers') || [];
                this.projects = this.getFromStorage('projects') || [];
                this.donations = this.getFromStorage('donations') || [];

                // Se não houver projetos, carregar exemplos
                if (this.projects.length === 0) {
                    this.loadSampleProjects();
                }

                // Se não houver voluntários, carregar exemplos
                if (this.volunteers.length === 0) {
                    this.loadSampleVolunteers();
                }

                // Renderizar projetos na página inicial
                this.renderProjects();
                
                // Renderizar voluntários
                this.renderVolunteers();
            }

