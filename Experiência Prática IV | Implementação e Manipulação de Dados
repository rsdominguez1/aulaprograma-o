-- 1. CRIAÇÃO DO BANCO DE DADOS
DROP DATABASE IF EXISTS consultorio_veterinario;
CREATE DATABASE consultorio_veterinario;
USE consultorio_veterinario;

-- 2. CRIAÇÃO DAS TABELAS

-- Tabela ENDERECO
CREATE TABLE ENDERECO (
    ID_Endereco INT AUTO_INCREMENT PRIMARY KEY,
    Logradouro VARCHAR(100) NOT NULL,
    Numero VARCHAR(10) NOT NULL,
    Complemento VARCHAR(50),
    Bairro VARCHAR(50) NOT NULL,
    Cidade VARCHAR(50) NOT NULL,
    Estado CHAR(2) NOT NULL,
    CEP VARCHAR(8) NOT NULL,
    Data_Cadastro TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabela CLIENTE
CREATE TABLE CLIENTE (
    ID_Cliente INT AUTO_INCREMENT PRIMARY KEY,
    Nome VARCHAR(100) NOT NULL,
    CPF VARCHAR(11) UNIQUE NOT NULL,
    Telefone VARCHAR(15),
    Email VARCHAR(100),
    ID_Endereco INT,
    Data_Cadastro TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (ID_Endereco) REFERENCES ENDERECO(ID_Endereco)
);

-- Tabela ANIMAL
CREATE TABLE ANIMAL (
    ID_Animal INT AUTO_INCREMENT PRIMARY KEY,
    Nome VARCHAR(50) NOT NULL,
    Especie VARCHAR(30) NOT NULL,
    Raca VARCHAR(50),
    Data_Nascimento DATE,
    Peso DECIMAL(5,2),
    Observacoes TEXT,
    ID_Cliente INT NOT NULL,
    Data_Cadastro TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (ID_Cliente) REFERENCES CLIENTE(ID_Cliente) ON DELETE CASCADE
);

-- Tabela VETERINARIO
CREATE TABLE VETERINARIO (
    ID_Vet INT AUTO_INCREMENT PRIMARY KEY,
    Nome VARCHAR(100) NOT NULL,
    CRMV VARCHAR(20) UNIQUE NOT NULL,
    Telefone VARCHAR(15),
    Email VARCHAR(100),
    Especialidade_Principal VARCHAR(50) NOT NULL,
    Data_Admissao DATE NOT NULL,
    Ativo BOOLEAN DEFAULT TRUE
);

-- Tabela PRINC_ATIVO
CREATE TABLE PRINC_ATIVO (
    ID_Principio INT AUTO_INCREMENT PRIMARY KEY,
    Nome VARCHAR(100) NOT NULL UNIQUE,
    Concentracoes_Tipicas VARCHAR(200)
);

-- Tabela MEDICAMENTO
CREATE TABLE MEDICAMENTO (
    ID_Medicamento INT AUTO_INCREMENT PRIMARY KEY,
    Nome_Comercial VARCHAR(100) NOT NULL,
    ID_Principio INT,
    Forma_Farmaceutica VARCHAR(30) NOT NULL,
    Via_Administracao VARCHAR(30),
    FOREIGN KEY (ID_Principio) REFERENCES PRINC_ATIVO(ID_Principio)
);

-- Tabela CONSULTA
CREATE TABLE CONSULTA (
    ID_Consulta INT AUTO_INCREMENT PRIMARY KEY,
    Data_Hora DATETIME NOT NULL,
    Motivo VARCHAR(200),
    Diagnostico TEXT,
    Observacoes TEXT,
    ID_Animal INT NOT NULL,
    ID_Vet INT NOT NULL,
    Status ENUM('Agendada', 'Realizada', 'Cancelada') DEFAULT 'Agendada',
    Data_Registro TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (ID_Animal) REFERENCES ANIMAL(ID_Animal) ON DELETE CASCADE,
    FOREIGN KEY (ID_Vet) REFERENCES VETERINARIO(ID_Vet)
);

-- Tabela PRESCRICAO
CREATE TABLE PRESCRICAO (
    ID_Prescricao INT AUTO_INCREMENT PRIMARY KEY,
    Posologia VARCHAR(200) NOT NULL,
    Duracao VARCHAR(50),
    ID_Consulta INT NOT NULL,
    ID_Medicamento INT NOT NULL,
    Data_Prescricao TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (ID_Consulta) REFERENCES CONSULTA(ID_Consulta) ON DELETE CASCADE,
    FOREIGN KEY (ID_Medicamento) REFERENCES MEDICAMENTO(ID_Medicamento)
);

-- Tabela ESTOQUE
CREATE TABLE ESTOQUE (
    ID_Medicamento INT,
    Lote VARCHAR(20) NOT NULL,
    Validade DATE NOT NULL,
    Quantidade_Atual INT NOT NULL DEFAULT 0,
    Quantidade_Minima INT NOT NULL DEFAULT 5,
    Data_Entrada DATE NOT NULL,
    PRIMARY KEY (ID_Medicamento, Lote),
    FOREIGN KEY (ID_Medicamento) REFERENCES MEDICAMENTO(ID_Medicamento) ON DELETE CASCADE
);

-- 3. ÍNDICES PARA PERFORMANCE
CREATE INDEX idx_animal_cliente ON ANIMAL(ID_Cliente);
CREATE INDEX idx_consulta_animal ON CONSULTA(ID_Animal);
CREATE INDEX idx_consulta_vet ON CONSULTA(ID_Vet);
CREATE INDEX idx_prescricao_consulta ON PRESCRICAO(ID_Consulta);
CREATE INDEX idx_estoque_validade ON ESTOQUE(Validade);
CREATE INDEX idx_consulta_data ON CONSULTA(Data_Hora);

-- 4. VIEWS PARA RELATÓRIOS
CREATE VIEW vw_clientes_animais AS
SELECT 
    c.ID_Cliente,
    c.Nome AS Nome_Cliente,
    c.CPF,
    c.Telefone,
    COUNT(a.ID_Animal) AS Total_Animais,
    GROUP_CONCAT(a.Nome SEPARATOR ', ') AS Nomes_Animais
FROM CLIENTE c
LEFT JOIN ANIMAL a ON c.ID_Cliente = a.ID_Cliente
GROUP BY c.ID_Cliente, c.Nome, c.CPF, c.Telefone;

CREATE VIEW vw_consultas_recentes AS
SELECT 
    con.ID_Consulta,
    con.Data_Hora,
    a.Nome AS Nome_Animal,
    a.Especie,
    c.Nome AS Nome_Cliente,
    v.Nome AS Nome_Veterinario,
    con.Diagnostico,
    con.Status
FROM CONSULTA con
JOIN ANIMAL a ON con.ID_Animal = a.ID_Animal
JOIN CLIENTE c ON a.ID_Cliente = c.ID_Cliente
JOIN VETERINARIO v ON con.ID_Vet = v.ID_Vet
ORDER BY con.Data_Hora DESC;

CREATE VIEW vw_estoque_baixo AS
SELECT 
    m.Nome_Comercial,
    pa.Nome AS Principio_Ativo,
    e.Lote,
    e.Validade,
    e.Quantidade_Atual,
    e.Quantidade_Minima,
    DATEDIFF(e.Validade, CURDATE()) AS Dias_Para_Vencer,
    CASE 
        WHEN e.Quantidade_Atual < e.Quantidade_Minima THEN 'URGENTE'
        WHEN e.Quantidade_Atual < (e.Quantidade_Minima * 2) THEN 'ATENÇÃO'
        ELSE 'NORMAL'
    END AS Status_Estoque
FROM ESTOQUE e
JOIN MEDICAMENTO m ON e.ID_Medicamento = m.ID_Medicamento
JOIN PRINC_ATIVO pa ON m.ID_Principio = pa.ID_Principio
WHERE e.Quantidade_Atual < (e.Quantidade_Minima * 2)
ORDER BY Status_Estoque, Dias_Para_Vencer;

