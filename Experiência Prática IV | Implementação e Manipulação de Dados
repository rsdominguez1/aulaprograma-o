WHERE ID_Medicamento NOT IN (SELECT DISTINCT ID_Medicamento FROM PRESCRICAO)
  AND ID_Medicamento NOT IN (SELECT DISTINCT ID_Medicamento FROM ESTOQUE);

-- DELETE 5: Remover cliente inativo (sem animais há mais de 2 anos)
DELETE FROM CLIENTE 
WHERE ID_Cliente NOT IN (
    SELECT DISTINCT a.ID_Cliente 
    FROM ANIMAL a 
    WHERE a.Data_Cadastro >= DATE_SUB(CURDATE(), INTERVAL 2 YEAR)
);

-- 8. PROCEDURES E FUNÇÕES ÚTEIS

-- Procedure para registrar nova consulta
DELIMITER $$
CREATE PROCEDURE sp_agendar_consulta(
    IN p_data_hora DATETIME,
    IN p_motivo VARCHAR(200),
    IN p_id_animal INT,
    IN p_id_vet INT
)
BEGIN
    INSERT INTO CONSULTA (Data_Hora, Motivo, ID_Animal, ID_Vet, Status)
    VALUES (p_data_hora, p_motivo, p_id_animal, p_id_vet, 'Agendada');
    SELECT LAST_INSERT_ID() AS Novo_ID_Consulta;
END$$
DELIMITER ;

-- Function para calcular idade do animal
DELIMITER $$
CREATE FUNCTION fn_calcular_idade_animal(p_id_animal INT)
RETURNS VARCHAR(50)
DETERMINISTIC
BEGIN
    DECLARE v_data_nascimento DATE;
    DECLARE v_anos INT;
    DECLARE v_meses INT;
    
    SELECT Data_Nascimento INTO v_data_nascimento
    FROM ANIMAL WHERE ID_Animal = p_id_animal;
    
    SET v_anos = TIMESTAMPDIFF(YEAR, v_data_nascimento, CURDATE());
    SET v_meses = TIMESTAMPDIFF(MONTH, v_data_nascimento, CURDATE()) % 12;
    
    RETURN CONCAT(v_anos, ' anos e ', v_meses, ' meses');
END$$
DELIMITER ;

-- 9. TRIGGERS PARA INTEGRIDADE

-- Trigger para atualizar data de cadastro automática
DELIMITER $$
CREATE TRIGGER tg_cliente_before_insert
BEFORE INSERT ON CLIENTE
FOR EACH ROW
BEGIN
    SET NEW.Data_Cadastro = CURRENT_TIMESTAMP;
END$$
DELIMITER ;

-- Trigger para verificar estoque mínimo
DELIMITER $$
CREATE TRIGGER tg_estoque_after_update
AFTER UPDATE ON ESTOQUE
FOR EACH ROW
BEGIN
    IF NEW.Quantidade_Atual < NEW.Quantidade_Minima THEN
        INSERT INTO log_estoque_baixo (ID_Medicamento, Lote, Quantidade_Atual, Quantidade_Minima, Data_Alerta)
        VALUES (NEW.ID_Medicamento, NEW.Lote, NEW.Quantidade_Atual, NEW.Quantidade_Minima, NOW());
    END IF;
END$$
DELIMITER ;

-- 10. RELATÓRIOS PRONTOS

-- Relatório 1: Resumo mensal
SELECT 
    MONTH(Data_Hora) AS Mes,
    YEAR(Data_Hora) AS Ano,
    COUNT(*) AS Total_Consultas,
    SUM(CASE WHEN Status = 'Realizada' THEN 1 ELSE 0 END) AS Consultas_Realizadas,
    SUM(CASE WHEN Status = 'Cancelada' THEN 1 ELSE 0 END) AS Consultas_Canceladas,
    COUNT(DISTINCT ID_Animal) AS Animais_Atendidos,
    COUNT(DISTINCT ID_Vet) AS Veterinarios_Atuantes
FROM CONSULTA
GROUP BY YEAR(Data_Hora), MONTH(Data_Hora)
ORDER BY Ano DESC, Mes DESC;

-- Relatório 2: Top 5 medicamentos mais prescritos
SELECT 
    m.Nome_Comercial,
    pa.Nome AS Principio_Ativo,
    COUNT(p.ID_Prescricao) AS Total_Prescrito,
    SUM(e.Quantidade_Atual) AS Estoque_Total
FROM MEDICAMENTO m
JOIN PRINC_ATIVO pa ON m.ID_Principio = pa.ID_Principio
LEFT JOIN PRESCRICAO p ON m.ID_Medicamento = p.ID_Medicamento
LEFT JOIN ESTOQUE e ON m.ID_Medicamento = e.ID_Medicamento
GROUP BY m.ID_Medicamento, m.Nome_Comercial, pa.Nome
ORDER BY Total_Prescrito DESC
LIMIT 5;

-- Relatório 3: Clientes com mais animais
SELECT 
    c.Nome AS Cliente,
    c.Telefone,
    COUNT(a.ID_Animal) AS Total_Animais,
    GROUP_CONCAT(CONCAT(a.Nome, ' (', a.Especie, ')') SEPARATOR '; ') AS Lista_Animais
FROM CLIENTE c
JOIN ANIMAL a ON c.ID_Cliente = a.ID_Cliente
GROUP BY c.ID_Cliente, c.Nome, c.Telefone
HAVING COUNT(a.ID_Animal) > 1
ORDER BY Total_Animais DESC;

