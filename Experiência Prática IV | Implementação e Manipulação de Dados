-- 6. CONSULTAS DE EXEMPLO

-- Consulta 1: Listar todos os animais com seus donos
SELECT 
    a.Nome AS Nome_Animal,
    a.Especie,
    a.Raca,
    a.Peso,
    c.Nome AS Dono,
    c.Telefone
FROM ANIMAL a
JOIN CLIENTE c ON a.ID_Cliente = c.ID_Cliente
ORDER BY a.Especie, a.Nome;

-- Consulta 2: Consultas realizadas em março de 2024
SELECT 
    con.ID_Consulta,
    DATE_FORMAT(con.Data_Hora, '%d/%m/%Y %H:%i') AS Data_Consulta,
    a.Nome AS Animal,
    v.Nome AS Veterinario,
    con.Motivo,
    con.Diagnostico
FROM CONSULTA con
JOIN ANIMAL a ON con.ID_Animal = a.ID_Animal
JOIN VETERINARIO v ON con.ID_Vet = v.ID_Vet
WHERE con.Status = 'Realizada'
    AND con.Data_Hora BETWEEN '2024-03-01' AND '2024-03-31'
ORDER BY con.Data_Hora DESC;

-- Consulta 3: Veterinários e quantidade de consultas realizadas
SELECT 
    v.Nome AS Veterinario,
    v.Especialidade_Principal,
    COUNT(con.ID_Consulta) AS Total_Consultas,
    MIN(con.Data_Hora) AS Primeira_Consulta,
    MAX(con.Data_Hora) AS Ultima_Consulta
FROM VETERINARIO v
LEFT JOIN CONSULTA con ON v.ID_Vet = con.ID_Vet 
    AND con.Status = 'Realizada'
GROUP BY v.ID_Vet, v.Nome, v.Especialidade_Principal
ORDER BY Total_Consultas DESC;

-- Consulta 4: Medicamentos com estoque abaixo do mínimo
SELECT 
    m.Nome_Comercial,
    pa.Nome AS Principio_Ativo,
    e.Lote,
    e.Validade,
    e.Quantidade_Atual,
    e.Quantidade_Minima,
    CASE 
        WHEN e.Quantidade_Atual < e.Quantidade_Minima THEN 'REPOSIÇÃO URGENTE'
        WHEN e.Quantidade_Atual < (e.Quantidade_Minima * 2) THEN 'REPOSIÇÃO NECESSÁRIA'
        ELSE 'ESTOQUE OK'
    END AS Status_Estoque
FROM ESTOQUE e
JOIN MEDICAMENTO m ON e.ID_Medicamento = m.ID_Medicamento
JOIN PRINC_ATIVO pa ON m.ID_Principio = pa.ID_Principio
WHERE e.Quantidade_Atual < (e.Quantidade_Minima * 2)
ORDER BY Status_Estoque, e.Validade;

-- Consulta 5: Histórico completo de consultas com prescrições
SELECT 
    DATE_FORMAT(c.Data_Hora, '%d/%m/%Y %H:%i') AS Data_Consulta,
    a.Nome AS Animal,
    cli.Nome AS Dono,
    v.Nome AS Veterinario,
    c.Diagnostico,
    m.Nome_Comercial AS Medicamento,
    p.Posologia,
    p.Duracao
FROM CONSULTA c
JOIN ANIMAL a ON c.ID_Animal = a.ID_Animal
JOIN CLIENTE cli ON a.ID_Cliente = cli.ID_Cliente
JOIN VETERINARIO v ON c.ID_Vet = v.ID_Vet
LEFT JOIN PRESCRICAO p ON c.ID_Consulta = p.ID_Consulta
LEFT JOIN MEDICAMENTO m ON p.ID_Medicamento = m.ID_Medicamento
WHERE c.Status = 'Realizada'
ORDER BY c.Data_Hora DESC, a.Nome;

