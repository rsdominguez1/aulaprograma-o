    <!-- JavaScript Otimizado -->
    <script>
        // ===== CONTROLES DE ACESSIBILIDADE =====
        class AccessibilityManager {
            constructor() {
                this.currentTheme = 'light';
                this.init();
            }

            init() {
                this.setupEventListeners();
                this.loadUserPreferences();
            }

            setupEventListeners() {
                // Controle de tema
                document.querySelector('.theme-btn').addEventListener('click', () => {
                    this.toggleTheme();
                });

                // Controle de alto contraste
                document.querySelector('.contrast-btn').addEventListener('click', () => {
                    this.toggleHighContrast();
                });

                // Menu mobile
                document.querySelector('.mobile-menu-toggle').addEventListener('click', (e) => {
                    this.toggleMobileMenu(e);
                });

                // Navegação por teclado
                document.addEventListener('keydown', (e) => {
                    this.handleKeyboardNavigation(e);
                });
            }

            toggleTheme() {
                this.currentTheme = this.currentTheme === 'light' ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', this.currentTheme);
                localStorage.setItem('theme', this.currentTheme);
            }

            toggleHighContrast() {
                const isHighContrast = document.documentElement.getAttribute('data-theme') === 'high-contrast';
                document.documentElement.setAttribute('data-theme', 
                    isHighContrast ? this.currentTheme : 'high-contrast');
                localStorage.setItem('highContrast', !isHighContrast);
            }

            toggleMobileMenu(e) {
                const menu = document.querySelector('.nav-list');
                const button = e.currentTarget;
                const isExpanded = button.getAttribute('aria-expanded') === 'true';

                menu.classList.toggle('active');
                button.setAttribute('aria-expanded', !isExpanded);
            }

            handleKeyboardNavigation(e) {
                // Navegação por teclado nos projetos
                if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
                    const projects = document.querySelectorAll('.project-card');
                    const currentIndex = Array.from(projects).findIndex(project => 
                        project === document.activeElement.closest('.project-card')
                    );

                    if (currentIndex !== -1) {
                        const nextIndex = e.key === 'ArrowRight' 
                            ? (currentIndex + 1) % projects.length
                            : (currentIndex - 1 + projects.length) % projects.length;
                        
                        projects[nextIndex].focus();
                        e.preventDefault();
                    }
                }
            }

            loadUserPreferences() {
                const savedTheme = localStorage.getItem('theme');
                const highContrast = localStorage.getItem('highContrast');

                if (savedTheme) {
                    this.currentTheme = savedTheme;
                    document.documentElement.setAttribute('data-theme', savedTheme);
                }

                if (highContrast === 'true') {
                    document.documentElement.setAttribute('data-theme', 'high-contrast');
                }
            }
        }

        // ===== VALIDAÇÃO DE FORMULÁRIO =====
        class FormValidator {
            constructor() {
                this.masks = new InputMasks();
                this.init();
            }

            init() {
                this.setupFormValidation();
                this.masks.applyMasks();
            }

            setupFormValidation() {
                const form = document.getElementById('volunteer-form');
                if (!form) return;

                form.addEventListener('submit', (e) => {
                    e.preventDefault();
                    if (this.validateForm(form)) {
                        this.showSuccessMessage();
                        form.reset();
                    }
                });

                // Validação em tempo real
                form.addEventListener('input', (e) => {
                    this.validateField(e.target);
                });
            }

            validateForm(form) {
                let isValid = true;
                const requiredFields = form.querySelectorAll('[required]');

                requiredFields.forEach(field => {
                    if (!this.validateField(field)) {
                        isValid = false;
                    }
                });

                return isValid;
            }

            validateField(field) {
                const value = field.value.trim();
                let isValid = true;

                // Limpar erros anteriores
                this.clearFieldError(field);

                // Validações específicas por tipo de campo
                switch (field.type) {
                    case 'email':
                        isValid = this.isValidEmail(value);
                        break;
                    case 'tel':
                        isValid = this.isValidPhone(value);
                        break;
                    default:
                        if (field.id === 'cpf') {
                            isValid = this.isValidCPF(value);
                        } else if (field.id === 'cep') {
                            isValid = this.isValidCEP(value);
                        }
                }

                // Validação de campo obrigatório
                if (field.required && !value) {
                    this.showFieldError(field, 'Este campo é obrigatório');
                    isValid = false;
                } else if (!isValid) {
                    this.showFieldError(field, this.getErrorMessage(field));
                } else {
                    this.showFieldSuccess(field);
                }

                return isValid;
            }

            isValidEmail(email) {
                const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                return re.test(email);
            }

            isValidPhone(phone) {
                const cleaned = phone.replace(/\D/g, '');
                return cleaned.length >= 10 && cleaned.length <= 11;
            }

            isValidCPF(cpf) {
                const cleaned = cpf.replace(/\D/g, '');
                return cleaned.length === 11;
            }

            isValidCEP(cep) {
                const cleaned = cep.replace(/\D/g, '');
                return cleaned.length === 8;
            }

            getErrorMessage(field) {
                const messages = {
                    email: 'Digite um e-mail válido',
                    tel: 'Digite um telefone válido',
                    cpf: 'Digite um CPF válido',
                    cep: 'Digite um CEP válido'
                };
                return messages[field.type] || messages[field.id] || 'Campo inválido';
            }

            showFieldError(field, message) {
                field.setAttribute('aria-invalid', 'true');
                
                const errorElement = document.createElement('div');
                errorElement.className = 'field-error';
                errorElement.style.cssText = `
                    color: var(--error);
                    font-size: var(--font-size-sm);
                    margin-top: var(--space-xs);
                `;
                errorElement.textContent = message;
                errorElement.id = `${field.id}-error`;
                
                field.parentNode.appendChild(errorElement);
            }

            showFieldSuccess(field) {
                field.setAttribute('aria-invalid', 'false');
                this.clearFieldError(field);
            }

            clearFieldError(field) {
                const existingError = field.parentNode.querySelector('.field-error');
                if (existingError) {
                    existingError.remove();
                }
            }

            showSuccessMessage() {
                const alert = document.createElement('div');
                alert.className = 'alert alert-success';
                alert.innerHTML = `
                    <strong>✅ Cadastro realizado com sucesso!</strong>
                    <p>Em breve entraremos em contato com mais informações.</p>
                `;
                
                const form = document.getElementById('volunteer-form');
                form.parentNode.insertBefore(alert, form);
                
                setTimeout(() => alert.remove(), 5000);
            }
        }

        // ===== MÁSCARAS DE INPUT =====
        class InputMasks {
            applyMasks() {
                this.maskCPF();
                this.maskPhone();
                this.maskCEP();
            }

            maskCPF() {
                const cpfInput = document.getElementById('cpf');
                if (cpfInput) {
                    cpfInput.addEventListener('input', (e) => {
                        let value = e.target.value.replace(/\D/g, '');
                        if (value.length <= 11) {
                            value = value.replace(/(\d{3})(\d)/, '$1.$2');
                            value = value.replace(/(\d{3})(\d)/, '$1.$2');
                            value = value.replace(/(\d{3})(\d{1,2})$/, '$1-$2');
                        }
                        e.target.value = value.substring(0, 14);
                    });
                }
            }

            maskPhone() {
                const phoneInput = document.getElementById('phone');
                if (phoneInput) {
                    phoneInput.addEventListener('input', (e) => {
                        let value = e.target.value.replace(/\D/g, '');
                        if (value.length <= 11) {
                            if (value.length <= 10) {
                                value = value.replace(/(\d{2})(\d)/, '($1) $2');
                                value = value.replace(/(\d{4})(\d)/, '$1-$2');
                            } else {
                                value = value.replace(/(\d{2})(\d)/, '($1) $2');
                                value = value.replace(/(\d{5})(\d)/, '$1-$2');
                            }
                        }
                        e.target.value = value.substring(0, 15);
                    });
                }
            }

            maskCEP() {
                const cepInput = document.getElementById('cep');
                if (cepInput) {
                    cepInput.addEventListener('input', (e) => {
                        let value = e.target.value.replace(/\D/g, '');
                        if (value.length <= 8) {
                            value = value.replace(/(\d{5})(\d)/, '$1-$2');
                        }
                        e.target.value = value.substring(0, 9);
                    });
                }
            }
        }

        // ===== INICIALIZAÇÃO DA APLICAÇÃO =====
        document.addEventListener('DOMContentLoaded', () => {
            // Inicializar gerenciador de acessibilidade
            window.accessibilityManager = new AccessibilityManager();
            
            // Inicializar validador de formulário
            window.formValidator = new FormValidator();
            
            // Smooth scroll para links internos
            document.querySelectorAll('a[href^="#"]').forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    const target = document.querySelector(link.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth' });
                        target.focus({ preventScroll: true });
                    }
                });
            });

            // Log de carregamento bem-sucedido
            console.log('✅ Plataforma ONG carregada com sucesso!');
            console.log('🎯 Recursos disponíveis:');
            console.log('   • Acessibilidade (WCAG 2.1 AA)');
            console.log('   • Modo escuro e alto contraste');
            console.log('   • Validação de formulários');
            console.log('   • Navegação por teclado');
            console.log('   • Design responsivo');
        });

        // ===== OTIMIZAÇÕES DE PERFORMANCE =====
        // Preload de recursos críticos
        const criticalResources = [];
        criticalResources.forEach(resource => {
            const link = document.createElement('link');
            link.rel = 'preload';
            link.href = resource;
            document.head.appendChild(link);
        });

        // Lazy loading para imagens
        if ('IntersectionObserver' in window) {
            const imageObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const img = entry.target;
                        img.src = img.dataset.src;
                        imageObserver.unobserve(img);
                    }
                });
            });

            document.querySelectorAll('img[data-src]').forEach(img => {
                imageObserver.observe(img);
            });
        }
    </script>

