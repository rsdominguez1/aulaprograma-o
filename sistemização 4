<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ONG Solidária - Plataforma Completa | Transformando Vidas</title>
    <meta name="description" content="Plataforma web completa para ONGs gerenciarem projetos, voluntários e doações. Desenvolvida com acessibilidade, performance e melhores práticas.">
    <meta name="keywords" content="ONG, voluntariado, doações, projetos sociais, acessibilidade">
    <meta name="author" content="Equipe ONG Solidária">
    
    <!-- Open Graph -->
    <meta property="og:title" content="ONG Solidária - Plataforma Completa">
    <meta property="og:description" content="Transformando vidas através de tecnologia acessível">
    <meta property="og:type" content="website">
    
    <!-- Favicon -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🤝</text></svg>">
    
    <!-- CSS Otimizado -->
    <style>
        /* ===== VARIÁVEIS CSS E DESIGN SYSTEM ===== */
        :root {
            /* Cores - Modo Claro (Padrão) */
            --primary-50: #e3f2fd;
            --primary-100: #bbdefb;
            --primary-500: #2196f3;
            --primary-600: #1e88e5;
            --primary-700: #1976d2;
            --primary-900: #0d47a1;
            
            --secondary-50: #e8f5e8;
            --secondary-500: #4caf50;
            --secondary-600: #43a047;
            --secondary-700: #388e3c;
            
            --neutral-50: #fafafa;
            --neutral-100: #f5f5f5;
            --neutral-200: #eeeeee;
            --neutral-300: #e0e0e0;
            --neutral-400: #bdbdbd;
            --neutral-500: #9e9e9e;
            --neutral-600: #757575;
            --neutral-700: #616161;
            --neutral-800: #424242;
            --neutral-900: #212121;
            
            --success: #4caf50;
            --warning: #ff9800;
            --error: #f44336;
            --info: #2196f3;
            
            --text-primary: var(--neutral-900);
            --text-secondary: var(--neutral-700);
            --text-disabled: var(--neutral-500);
            --bg-primary: #ffffff;
            --bg-secondary: var(--neutral-50);
            --bg-surface: #ffffff;
            --border-color: var(--neutral-200);
            
            /* Espaçamento Modular */
            --space-xs: 0.5rem;
            --space-sm: 1rem;
            --space-md: 1.5rem;
            --space-lg: 2rem;
            --space-xl: 3rem;
            --space-2xl: 4rem;
            
            /* Tipografia */
            --font-size-xs: 0.75rem;
            --font-size-sm: 0.875rem;
            --font-size-md: 1rem;
            --font-size-lg: 1.125rem;
            --font-size-xl: 1.25rem;
            --font-size-2xl: 1.5rem;
            --font-size-3xl: 1.875rem;
            --font-size-4xl: 2.25rem;
            
            --font-weight-normal: 400;
            --font-weight-medium: 500;
            --font-weight-semibold: 600;
            --font-weight-bold: 700;
            
            /* Outras Variáveis */
            --border-radius-sm: 0.25rem;
            --border-radius-md: 0.5rem;
            --border-radius-lg: 0.75rem;
            
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            
            --transition-fast: 150ms ease;
            --transition-normal: 300ms ease;
            
            --z-index-sticky: 1020;
            --z-index-modal: 1040;
            --z-index-dropdown: 1000;
        }

        /* ===== MODO DE ALTO CONTRASTE ===== */
        [data-theme="high-contrast"] {
            --text-primary: #000000;
            --text-secondary: #000000;
            --bg-primary: #ffffff;
            --bg-secondary: #ffff00;
            --bg-surface: #ffffff;
            --border-color: #000000;
            --primary-500: #0000ff;
            --secondary-500: #008000;
            --success: #008000;
            --error: #ff0000;
            --warning: #ffa500;
        }

        /* ===== MODO ESCURO ===== */
        [data-theme="dark"] {
            --text-primary: #ffffff;
            --text-secondary: #e0e0e0;
            --bg-primary: #121212;
            --bg-secondary: #1e1e1e;
            --bg-surface: #2d2d2d;
            --border-color: #404040;
            --neutral-50: #1e1e1e;
            --neutral-100: #2d2d2d;
            --neutral-200: #404040;
        }

        /* ===== RESET E ESTILOS BASE ===== */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            line-height: 1.15;
            -webkit-text-size-adjust: 100%;
            scroll-behavior: smooth;
        }

        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: var(--font-size-md);
            line-height: 1.6;
            color: var(--text-primary);
            background-color: var(--bg-primary);
            transition: background-color var(--transition-normal), color var(--transition-normal);
        }

        /* ===== ACESSIBILIDADE - FOCO VISÍVEL ===== */
        :focus-visible {
            outline: 3px solid var(--primary-500);
            outline-offset: 2px;
        }

        .skip-link {
            position: absolute;
            top: -40px;
            left: 6px;
            background: var(--primary-500);
            color: white;
            padding: var(--space-xs) var(--space-sm);
            text-decoration: none;
            border-radius: var(--border-radius-sm);
            z-index: 9999;
            transition: top 0.3s;
        }

        .skip-link:focus {
            top: 6px;
        }

        /* ===== LAYOUT PRINCIPAL ===== */
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 var(--space-sm);
        }

        .grid {
            display: grid;
            gap: var(--space-md);
        }

        .grid-cols-1 { grid-template-columns: 1fr; }
        .grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
        .grid-cols-3 { grid-template-columns: repeat(3, 1fr); }

        @media (min-width: 768px) {
            .grid-cols-md-2 { grid-template-columns: repeat(2, 1fr); }
            .grid-cols-md-3 { grid-template-columns: repeat(3, 1fr); }
            .grid-cols-md-4 { grid-template-columns: repeat(4, 1fr); }
        }

        /* ===== HEADER E NAVEGAÇÃO ===== */
        .header {
            background-color: var(--bg-surface);
            box-shadow: var(--shadow-sm);
            position: sticky;
            top: 0;
            z-index: var(--z-index-sticky);
            border-bottom: 1px solid var(--border-color);
        }

        .header-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: var(--space-sm) 0;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: var(--space-sm);
            text-decoration: none;
            color: var(--text-primary);
        }

        .logo img {
            width: 40px;
            height: 40px;
            border-radius: var(--border-radius-md);
        }

        .logo h1 {
            font-size: var(--font-size-xl);
            font-weight: var(--font-weight-bold);
            color: var(--primary-700);
        }

        /* Controles de Acessibilidade */
        .accessibility-controls {
            display: flex;
            gap: var(--space-xs);
            margin-right: var(--space-md);
        }

        .theme-btn, .contrast-btn {
            background: none;
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius-sm);
            padding: var(--space-xs);
            cursor: pointer;
            color: var(--text-primary);
            transition: all var(--transition-fast);
        }

        .theme-btn:hover, .contrast-btn:hover {
            background-color: var(--neutral-100);
        }

        /* Navegação */
        .nav-list {
            display: flex;
            list-style: none;
            gap: var(--space-md);
        }

        .nav-link {
            padding: var(--space-xs) var(--space-sm);
            color: var(--text-primary);
            text-decoration: none;
            border-radius: var(--border-radius-md);
            transition: all var(--transition-fast);
            position: relative;
        }

        .nav-link:hover, .nav-link:focus {
            background-color: var(--primary-50);
            color: var(--primary-700);
        }

        .nav-link.active {
            background-color: var(--primary-500);
            color: white;
        }

        /* Menu Mobile */
        .mobile-menu-toggle {
            display: none;
            background: none;
            border: none;
            color: var(--text-primary);
            cursor: pointer;
            padding: var(--space-xs);
        }

        /* ===== COMPONENTES ===== */
        
        /* Botões */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: var(--space-xs);
            padding: var(--space-xs) var(--space-md);
            font-size: var(--font-size-md);
            font-weight: var(--font-weight-medium);
            text-decoration: none;
            border: none;
            border-radius: var(--border-radius-md);
            cursor: pointer;
            transition: all var(--transition-fast);
            background-color: var(--primary-500);
            color: white;
        }

        .btn:hover, .btn:focus {
            background-color: var(--primary-600);
            transform: translateY(-1px);
        }

        .btn:active {
            transform: translateY(0);
        }

        .btn-secondary {
            background-color: var(--secondary-500);
        }

        .btn-secondary:hover, .btn-secondary:focus {
            background-color: var(--secondary-600);
        }

        .btn-large {
            padding: var(--space-sm) var(--space-lg);
            font-size: var(--font-size-lg);
        }

        /* Cards */
        .card {
            background-color: var(--bg-surface);
            border-radius: var(--border-radius-lg);
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border-color);
            transition: all var(--transition-normal);
        }

        .card:hover {
            box-shadow: var(--shadow-md);
        }

        .card-header {
            padding: var(--space-md);
            border-bottom: 1px solid var(--border-color);
        }

        .card-body {
            padding: var(--space-md);
        }

        /* Formulários */
        .form-group {
            margin-bottom: var(--space-md);
        }

        .form-label {
            display: block;
            margin-bottom: var(--space-xs);
            font-weight: var(--font-weight-medium);
            color: var(--text-primary);
        }

        .form-input, .form-select, .form-textarea {
            width: 100%;
            padding: var(--space-sm);
            border: 2px solid var(--border-color);
            border-radius: var(--border-radius-md);
            background-color: var(--bg-primary);
            color: var(--text-primary);
            font-size: var(--font-size-md);
            transition: border-color var(--transition-fast);
        }

        .form-input:focus, .form-select:focus, .form-textarea:focus {
            outline: none;
            border-color: var(--primary-500);
        }

        .form-input:invalid {
            border-color: var(--error);
        }

        /* Alertas */
        .alert {
            padding: var(--space-md);
            margin-bottom: var(--space-md);
            border-radius: var(--border-radius-md);
            border-left: 4px solid transparent;
        }

        .alert-success {
            background-color: color-mix(in srgb, var(--success) 10%, transparent);
            border-left-color: var(--success);
            color: var(--text-primary);
        }

        .alert-error {
            background-color: color-mix(in srgb, var(--error) 10%, transparent);
            border-left-color: var(--error);
            color: var(--text-primary);
        }

        /* ===== SEÇÕES ===== */
        .section {
            padding: var(--space-2xl) 0;
        }

        .section-title {
            text-align: center;
            margin-bottom: var(--space-xl);
            color: var(--text-primary);
            font-size: var(--font-size-3xl);
        }

        .bg-light {
            background-color: var(--bg-secondary);
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(135deg, var(--primary-500), var(--secondary-500));
            color: white;
            padding: var(--space-2xl) 0;
            text-align: center;
        }

        .hero-title {
            font-size: var(--font-size-4xl);
            margin-bottom: var(--space-md);
            color: white;
        }

        .hero-description {
            font-size: var(--font-size-lg);
            margin-bottom: var(--space-xl);
            opacity: 0.9;
        }

        /* Projetos */
        .project-card {
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .project-image {
            height: 200px;
            background-color: var(--neutral-200);
            border-radius: var(--border-radius-lg) var(--border-radius-lg) 0 0;
            overflow: hidden;
        }

        .project-content {
            padding: var(--space-md);
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .project-title {
            font-size: var(--font-size-xl);
            margin-bottom: var(--space-sm);
            color: var(--text-primary);
        }

        .project-description {
            color: var(--text-secondary);
            margin-bottom: var(--space-md);
            flex: 1;
        }

        /* ===== FOOTER ===== */
        .footer {
            background-color: var(--neutral-800);
            color: white;
            padding: var(--space-2xl) 0 var(--space-lg);
        }

        .footer a {
            color: white;
        }

        .footer a:hover {
            color: var(--secondary-500);
        }

        .copyright {
            text-align: center;
            padding-top: var(--space-lg);
            border-top: 1px solid var(--neutral-700);
            margin-top: var(--space-xl);
        }

        /* ===== RESPONSIVIDADE ===== */
        @media (max-width: 768px) {
            .mobile-menu-toggle {
                display: block;
            }

            .nav-list {
                display: none;
                position: absolute;
                top: 100%;
                left: 0;
                width: 100%;
                background-color: var(--bg-surface);
                flex-direction: column;
                padding: var(--space-md);
                box-shadow: var(--shadow-lg);
            }

            .nav-list.active {
                display: flex;
            }

            .accessibility-controls {
                margin-right: 0;
            }
        }

        /* ===== UTILITÁRIOS ===== */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .text-center { text-align: center; }
        .mt-md { margin-top: var(--space-md); }
        .mb-md { margin-bottom: var(--space-md); }
    </style>
</head>
<body>
    <!-- Skip Link para Acessibilidade -->
    <a href="#main-content" class="skip-link">Pular para o conteúdo principal</a>

    <!-- Header -->
    <header class="header" role="banner">
        <div class="container header-container">
            <a href="#" class="logo">
                <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%232196f3'%3E%3Cpath d='M12 2L1 21h22L12 2zm0 4l7.5 13h-15L12 6z'/%3E%3C/svg%3E" alt="Logo ONG Solidária" width="40" height="40">
                <h1>ONG Solidária</h1>
            </a>

            <!-- Controles de Acessibilidade -->
            <div class="accessibility-controls">
                <button class="theme-btn" aria-label="Alternar modo escuro" title="Modo escuro">
                    <span aria-hidden="true">🌙</span>
                </button>
                <button class="contrast-btn" aria-label="Alternar alto contraste" title="Alto contraste">
                    <span aria-hidden="true">⚫</span>
                </button>
            </div>

            <!-- Navegação Principal -->
            <nav aria-label="Navegação principal">
                <button class="mobile-menu-toggle" aria-expanded="false" aria-controls="main-nav">
                    <span aria-hidden="true">☰</span>
                    <span class="sr-only">Menu</span>
                </button>
                
                <ul class="nav-list" id="main-nav" role="menubar">
                    <li role="none"><a href="#home" class="nav-link active" role="menuitem">Início</a></li>
                    <li role="none"><a href="#projects" class="nav-link" role="menuitem">Projetos</a></li>
                    <li role="none"><a href="#volunteers" class="nav-link" role="menuitem">Voluntários</a></li>
                    <li role="none"><a href="#donations" class="nav-link" role="menuitem">Doações</a></li>
                    <li role="none"><a href="#registration" class="nav-link" role="menuitem">Cadastro</a></li>
                    <li role="none"><a href="#contact" class="nav-link" role="menuitem">Contato</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- Conteúdo Principal -->
    <main id="main-content" tabindex="-1">
        <!-- Hero Section -->
        <section id="home" class="hero" aria-labelledby="hero-title">
            <div class="container">
                <h1 id="hero-title" class="hero-title">Transformando Vidas Juntos</h1>
                <p class="hero-description">
                    Há mais de 15 anos atuando em comunidades carentes, promovendo educação, 
                    saúde e oportunidades para milhares de pessoas.
                </p>
                <div class="hero-actions">
                    <a href="#registration" class="btn btn-large">Seja um Voluntário</a>
                    <a href="#projects" class="btn btn-secondary btn-large">Conheça nossos Projetos</a>
                </div>
            </div>
        </section>

        <!-- Sobre Nós -->
        <section class="section" aria-labelledby="about-title">
            <div class="container">
                <h2 id="about-title" class="section-title">Sobre Nós</h2>
                <div class="grid grid-cols-1 grid-cols-md-2 gap-lg">
                    <div>
                        <h3>Nossa Missão</h3>
                        <p>Promover o desenvolvimento social e humano através de ações que garantam direitos, ampliem oportunidades e fortaleçam a cidadania em comunidades vulneráveis.</p>
                        
                        <h3 class="mt-md">Nossa Visão</h3>
                        <p>Ser referência nacional em transformação social, com projetos sustentáveis que gerem impacto positivo e duradouro na vida das pessoas.</p>
                    </div>
                    <div>
                        <div class="card">
                            <div class="card-body">
                                <h4>Nossos Valores</h4>
                                <ul>
                                    <li>✅ <strong>Solidariedade:</strong> Agimos com empatia e compromisso</li>
                                    <li>✅ <strong>Transparência:</strong> Prestamos contas de todas as ações</li>
                                    <li>✅ <strong>Colaboração:</strong> Acreditamos no trabalho em equipe</li>
                                    <li>✅ <strong>Sustentabilidade:</strong> Buscamos impacto duradouro</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Projetos -->
        <section id="projects" class="section bg-light" aria-labelledby="projects-title">
            <div class="container">
                <h2 id="projects-title" class="section-title">Nossos Projetos</h2>
                <div class="grid grid-cols-1 grid-cols-md-3 gap-lg">
                    <!-- Projeto 1 -->
                    <article class="card project-card" aria-labelledby="project-1-title">
                        <div class="project-image" role="img" aria-label="Crianças estudando em sala de aula"></div>
                        <div class="project-content">
                            <h3 id="project-1-title" class="project-title">Educação para Todos</h3>
                            <p class="project-description">
                                Oferecemos reforço escolar, cursos profissionalizantes e biblioteca comunitária 
                                para crianças e jovens em situação de vulnerabilidade.
                            </p>
                            <div class="project-meta">
                                <p><strong>📍 Localização:</strong> São Paulo, SP</p>
                                <p><strong>👥 Impacto:</strong> 150 crianças atendidas</p>
                            </div>
                            <button class="btn btn-block mt-md">Apoiar este Projeto</button>
                        </div>
                    </article>

                    <!-- Projeto 2 -->
                    <article class="card project-card" aria-labelledby="project-2-title">
                        <div class="project-image" role="img" aria-label="Profissionais de saúde atendendo comunidade"></div>
                        <div class="project-content">
                            <h3 id="project-2-title" class="project-title">Saúde em Ação</h3>
                            <p class="project-description">
                                Realizamos mutirões de saúde, prevenção de doenças e acompanhamento de gestantes 
                                na comunidade carente.
                            </p>
                            <div class="project-meta">
                                <p><strong>📍 Localização:</strong> Rio de Janeiro, RJ</p>
                                <p><strong>👥 Impacto:</strong> 2.000 atendimentos</p>
                            </div>
                            <button class="btn btn-block mt-md">Apoiar este Projeto</button>
                        </div>
                    </article>

                    <!-- Projeto 3 -->
                    <article class="card project-card" aria-labelledby="project-3-title">
                        <div class="project-image" role="img" aria-label="Horta comunitária sustentável"></div>
                        <div class="project-content">
                            <h3 id="project-3-title" class="project-title">Sustentabilidade Comunitária</h3>
                            <p class="project-description">
                                Promovemos hortas comunitárias, reciclagem e geração de renda através de 
                                práticas sustentáveis e ecológicas.
                            </p>
                            <div class="project-meta">
                                <p><strong>📍 Localização:</strong> Belo Horizonte, MG</p>
                                <p><strong>👥 Impacto:</strong> Famílias beneficiadas</p>
                            </div>
                            <button class="btn btn-block mt-md">Apoiar este Projeto</button>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <!-- Formulário de Cadastro -->
        <section id="registration" class="section" aria-labelledby="registration-title">
            <div class="container">
                <h2 id="registration-title" class="section-title">Cadastro de Voluntário</h2>
                
                <div class="card">
                    <div class="card-body">
                        <form id="volunteer-form" aria-labelledby="registration-title">
                            <fieldset>
                                <legend class="form-legend">Dados Pessoais</legend>
                                
                                <div class="grid grid-cols-1 grid-cols-md-2 gap-md">
                                    <div class="form-group">
                                        <label for="full-name" class="form-label">Nome Completo *</label>
                                        <input type="text" id="full-name" class="form-input" required aria-required="true">
                                    </div>
                                    
                                    <div class="form-group">
                                        <label for="email" class="form-label">E-mail *</label>
                                        <input type="email" id="email" class="form-input" required aria-required="true">
                                    </div>
                                </div>
                                
                                <div class="grid grid-cols-1 grid-cols-md-3 gap-md">
                                    <div class="form-group">
                                        <label for="cpf" class="form-label">CPF *</label>
                                        <input type="text" id="cpf" class="form-input" required aria-required="true" maxlength="14">
                                    </div>
                                    
                                    <div class="form-group">
                                        <label for="phone" class="form-label">Telefone *</label>
                                        <input type="tel" id="phone" class="form-input" required aria-required="true">
                                    </div>
                                    
